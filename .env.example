# ---------------------------------------------------------------
# TicketHive API environment. Copy to .env and fill in real values.
# Never commit .env.
# ---------------------------------------------------------------

# Port the API listens on (frontend proxies /api -> http://localhost:4000)
PORT=4000

# development | test | production
NODE_ENV=development

# Main database. Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Replace YOUR_POSTGRES_PASSWORD with the password of the local "postgres" user.
# (If the password has special characters like @ : / # %, URL-encode them.)
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/tickethive

# Separate database used only by `npm test` (tests wipe its data).
TEST_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/tickethive_test

# Secret used to sign JWT access tokens (HS256). Use a long random string (64+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Access token lifetime (jsonwebtoken format: 15m, 1h, ...)
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=7

# Frontend origin allowed by CORS (with credentials)
CORS_ORIGIN=http://localhost:4200
